# MAX Messenger bot token (get from @MasterBot in MAX)
MAX_BOT_TOKEN=your_max_bot_token_here

# DeepSeek API key (get from platform.deepseek.com)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# DeepSeek model to use
DEEPSEEK_MODEL=deepseek-chat

# System prompt for the AI (optional)
SYSTEM_PROMPT=You are a helpful assistant. Answer concisely and clearly.

# Max conversation history messages to keep per chat (default: 20)
MAX_HISTORY=20
